<Application x:Class="ООО_обувь.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ООО_обувь"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Общий шрифт для всех окон -->
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <!-- Основной фон -->
        </Style>

        <!-- Шрифт и стили для текстовых полей -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <!-- Если нужно выделить поле цветом, используем дополнительный фон #ABCFCE -->
            <Setter Property="Background" Value="#ABCFCE"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <!-- Шрифт и стили для кнопок -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <!-- Акцентирование внимания #546F94 -->
            <Setter Property="Background" Value="#546F94"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Шрифт и стили для выпадающих списков -->
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Padding" Value="4"/>
            <Style.Triggers>
                <!-- При наведении используем дополнительный фон -->
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#ABCFCE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Дополнительные стили для элементов списка (если используете ListView или DataGrid) -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
        </Style>

    </Application.Resources>
</Application>