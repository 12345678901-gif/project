<Window x:Class="ООО_обувь.managerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ООО_обувь"
        mc:Ignorable="d"
        Title="менеджер " Height="450" Width="800">
    <Grid>
        <Viewbox>
            <Grid Height="450" Width="800">
                <Button x:Name="ExitClick"
                        Content="Назад"
                        Width="74"
                        Margin="0,412,696,9"
                        HorizontalAlignment="Right"
                        Click="ExitClick_Click"/>

                <ListView x:Name="ListViewProduct"
                          Margin="195,64,10,64"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>

                <TextBox x:Name="TextBoxSearch"
                         HorizontalAlignment="Left" Margin="19,80,0,0"
                         VerticalAlignment="Top" Width="160"
                         TextChanged="TextBoxSearch_TextChanged"/>
                <Label Content="Поиск" HorizontalAlignment="Left" Margin="19,46,0,0" VerticalAlignment="Top"/>

                <Label Content="Сортировка" HorizontalAlignment="Left" Margin="19,127,0,0" VerticalAlignment="Top"/>
                <ComboBox x:Name="ComboBoxSort"
                          HorizontalAlignment="Left" Margin="19,157,0,0"
                          VerticalAlignment="Top" Width="155"
                          SelectedIndex="0"
                          SelectionChanged="ComboBoxSort_SelectionChanged">
                    <ComboBoxItem Content="Цена по возрастанию"/>
                    <ComboBoxItem Content="Цена по убыванию"/>
                    <ComboBoxItem Content="Количество по возрастанию"/>
                    <ComboBoxItem Content="Количество по убыванию"/>
                </ComboBox>

                <Label Content="Фильтрация" HorizontalAlignment="Left" Margin="19,235,0,0" VerticalAlignment="Top"/>
                <ComboBox x:Name="ComboBoxFilter"
                          HorizontalAlignment="Left" Margin="19,261,0,0"
                          VerticalAlignment="Top" Width="155"
                          SelectedIndex="0"
                          SelectionChanged="ComboBoxFilter_SelectionChanged">
                    <ComboBoxItem Content="Все диапазоны"/>
                    <ComboBoxItem Content="0–12,99%"/>
                    <ComboBoxItem Content="13–16,99%"/>
                    <ComboBoxItem Content="17% и более"/>
                </ComboBox>

                <Label x:Name="NameUserText" Content="Label"
                       HorizontalAlignment="Left" Margin="195,28,0,0"
                       VerticalAlignment="Top" Width="595"/>
                <Button x:Name="OrdersButtn" Content="Заказы" HorizontalAlignment="Left" Margin="133,412,0,0" VerticalAlignment="Top" Width="85" Height="28" Click="OrdersButtn_Click"/>
            </Grid>
        </Viewbox>
    </Grid>
</Window>