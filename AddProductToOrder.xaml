<Window x:Class="ООО_обувь.AddProductToOrder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить товар" Height="250" Width="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Label Content="Товар" VerticalAlignment="Top"/>
        <ComboBox x:Name="ProductBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                  Margin="0,30,0,0" VerticalAlignment="Top" Height="30"/>

        <Label Content="Количество" Margin="0,70,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="CountBox" Margin="0,100,0,0" VerticalAlignment="Top" Height="30"/>

        <Button Content="Добавить" Click="Ok_Click"
                HorizontalAlignment="Left" Margin="0,150,0,0"
                VerticalAlignment="Top" Width="100" Height="30"/>
        <Button Content="Отмена" Click="Cancel_Click"
                HorizontalAlignment="Left" Margin="110,150,0,0"
                VerticalAlignment="Top" Width="100" Height="30"/>
    </Grid>
</Window>