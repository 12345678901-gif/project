<Window x:Class="ООО_обувь.Добавление_нового_товара"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ООО_обувь"
        mc:Ignorable="d"
        Title="Добавление нового товара" Height="750" Width="800">
    <Grid>
        <Viewbox>
            <Grid Height="750" Width="800">
                <Label Content="Артикул" HorizontalAlignment="Left" Margin="49,23,0,0" VerticalAlignment="Top"/>
                <Label Content="Название" HorizontalAlignment="Left" Margin="53,54,0,0" VerticalAlignment="Top"/>
                <Label Content="Ед измерения" HorizontalAlignment="Left" Margin="33,101,0,0" VerticalAlignment="Top"/>
                <Label Content="Цена" HorizontalAlignment="Left" Margin="69,150,0,0" VerticalAlignment="Top"/>
                <Label Content="Поставщик" HorizontalAlignment="Left" Margin="40,198,0,0" VerticalAlignment="Top"/>
                <Label Content="Производитель" HorizontalAlignment="Left" Margin="22,245,0,0" VerticalAlignment="Top"/>
                <Label Content="Категория" HorizontalAlignment="Left" Margin="46,289,0,0" VerticalAlignment="Top"/>
                <Label Content="Скидка" HorizontalAlignment="Left" Margin="23,652,0,0" VerticalAlignment="Top"/>
                <Label Content="Описание" HorizontalAlignment="Left" Margin="11,497,0,0" VerticalAlignment="Top"/>
                <Label Content="Фото" HorizontalAlignment="Left" Margin="22,321,0,0" VerticalAlignment="Top"/>

                <Button Content="Выбрать" Click="SelectImage_Click"
                        HorizontalAlignment="Left" Margin="21,350,0,0" VerticalAlignment="Top"/>

                <Image x:Name="image" Margin="109,346,472,275" Stretch="Uniform"/>

                <TextBox x:Name="DescriptionBox"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Margin="112,497,474,139"/>

                <Button Content="Создать" Click="Button_Click"
                        HorizontalAlignment="Left" Margin="293,689,0,0"
                        VerticalAlignment="Top" Height="56" Width="72"/>
                <Button Content="Отмена" Click="Cancel_Click"
                        HorizontalAlignment="Left" Margin="385,689,0,0"
                        VerticalAlignment="Top" Height="56" Width="69"/>

                <TextBox x:Name="ArticleBox" Margin="132,20,203,700"/>
                <TextBox x:Name="NameBox" Margin="132,67,203,653"/>

                <ComboBox x:Name="UnitBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                          Margin="132,104,203,622"/>
                <TextBox x:Name="PriceBox" Margin="132,147,203,573"/>
                <ComboBox x:Name="SupplierBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                          Margin="132,201,203,525"/>
                <ComboBox x:Name="ManufacturerBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                          Margin="132,248,203,478"/>
                <ComboBox x:Name="CategoryBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                          Margin="132,291,203,435"/>
                <TextBox x:Name="SaleBox" Margin="98,649,237,71"/>
            </Grid>
        </Viewbox>
    </Grid>
</Window>