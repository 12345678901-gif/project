<Window x:Class="ООО_обувь.AddNewOrder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ООО_обувь"
        mc:Ignorable="d"
        Title="Новый заказ" Height="600" Width="1000">
    <Grid>
        <Viewbox>
            <Grid Height="600" Width="1000">
                <Label Content="Код заказа" HorizontalAlignment="Left" Margin="27,49,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="CodeBox" Margin="172,49,460,521"/>

                <Label Content="Статус заказа" HorizontalAlignment="Left" Margin="19,97,0,0" VerticalAlignment="Top"/>
                <ComboBox x:Name="StatusBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                          Margin="172,100,460,476"/>

                <Label Content="Покупатель" HorizontalAlignment="Left" Margin="27,145,0,0" VerticalAlignment="Top"/>
                <ComboBox x:Name="UserBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                          Margin="172,148,460,428"/>

                <Label Content="Дата заказа" HorizontalAlignment="Left" Margin="29,194,0,0" VerticalAlignment="Top"/>
                <DatePicker x:Name="OrderDateBox" Margin="172,194,452,382"/>

                <Label Content="Дата выдачи" HorizontalAlignment="Left" Margin="17,242,0,0" VerticalAlignment="Top"/>
                <DatePicker x:Name="DeliveryDateBox" Margin="172,238,452,338"/>

                <Label Content="Пункт выдачи" HorizontalAlignment="Left" Margin="19,304,0,0" VerticalAlignment="Top"/>
                <ComboBox x:Name="PickupBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                          Margin="176,300,456,276"/>

               
                <Label Content="Товары в заказе" HorizontalAlignment="Left"
                       Margin="562,21,0,0" VerticalAlignment="Top"/>

                <ListView x:Name="ListViewOrderProducts"
                          Margin="562,49,20,140"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>

                <Button Content="Добавить товар" Click="AddProduct_Click"
                        HorizontalAlignment="Left" Margin="562,510,0,0"
                        VerticalAlignment="Top" Width="130" Height="30"/>

                <Button Content="Убрать товар" Click="RemoveProduct_Click"
                        HorizontalAlignment="Left" Margin="700,510,0,0"
                        VerticalAlignment="Top" Width="130" Height="30"/>

                <Button Content="Создать заказ" Click="Button_Click"
                        HorizontalAlignment="Left" Margin="387,550,0,0"
                        VerticalAlignment="Top" Width="124" Height="30"/>
                <Button x:Name="btnexit" Content="Назад" Click="btnexit_Click"
                    HorizontalAlignment="Left" Margin="236,550,0,0"
                    VerticalAlignment="Top" Width="124" Height="30"/>
            </Grid>
        </Viewbox>
    </Grid>
</Window>