<Window x:Class="ООО_обувь.UserOrders"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ООО_обувь"
        mc:Ignorable="d"
        Title="список заказов" Height="600" Width="1000">
    <Grid>
        <Viewbox>
            <Grid Height="600" Width="1000">
                <Button x:Name="ExitClick"
                        Content="Назад"
                        Width="74"
                        Margin="0,547,703,24"
                        HorizontalAlignment="Right"
                        Click="ExitClick_Click"/>

                <!-- Заказы -->
                <Label Content="Заказы" HorizontalAlignment="Left"
                       Margin="67,20,0,0" VerticalAlignment="Top"/>
                <ListView x:Name="ListViewOrders"
                          Margin="67,48,520,80"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="ListViewOrders_SelectionChanged">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>

                <!-- Товары выбранного заказа -->
                <Label Content="Товары в заказе" HorizontalAlignment="Left"
                       Margin="530,20,0,0" VerticalAlignment="Top"/>
                <ListView x:Name="ListViewOrderProducts"
                          Margin="530,48,20,80"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
            </Grid>
        </Viewbox>
    </Grid>
</Window>