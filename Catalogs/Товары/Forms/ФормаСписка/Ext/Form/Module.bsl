&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Заголовок = "Выберите файл для загрузки";
	Диалог.Фильтр = "Excel (*.xls, *.xlsx)|*.xls;*.xlsx";
	Если Диалог.Выбрать() Тогда
		ПутьКФайлу = Диалог.ПолноеИмяФайла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПродукты(Команда)
	Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Сообщить("Файл не выбран");
	Иначе
		ЗагрузитьПродуктыНаСервере();
		Элементы.Список.Обновить();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПродуктыНаСервере()
	
	Попытка
		Excel = Новый COMОбъект("Excel.Application");
		Книга = Excel.WorkBooks.Open(ПутьКФайлу);
	Исключение
		Сообщить("Ошибка при открытии файла: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Лист = Книга.Sheets(1);
	
	НомерСтроки = 2;
	Создано = 0;
	
	Пока СокрЛП(Лист.Cells(НомерСтроки, 1).Text) <> "" Цикл
		
		Код = СокрЛП(Лист.Cells(НомерСтроки, 1).Text);
		Спр = Справочники.Товары.НайтиПоКоду(Код);
		
		Если Не ЗначениеЗаполнено(Спр) Тогда
			
			НовыйТовар = Справочники.Товары.СоздатьЭлемент();
			НовыйТовар.Код = Код;
			НовыйТовар.Артикул = СокрЛП(Лист.Cells(НомерСтроки, 2).Text);
			НовыйТовар.Наименование = СокрЛП(Лист.Cells(НомерСтроки, 3).Text);
			НовыйТовар.Единица_измерения = Справочники.Единица_измерения.НайтиПоКоду(СокрЛП(Лист.Cells(НомерСтроки, 4).Text));
			НовыйТовар.Цена = Лист.Cells(НомерСтроки, 5).Value;
			НовыйТовар.Поставщик = Справочники.Поставщики.НайтиПоКоду(СокрЛП(Лист.Cells(НомерСтроки, 6).Text));
			НовыйТовар.Производитель = Справочники.Производители.НайтиПоКоду(СокрЛП(Лист.Cells(НомерСтроки, 7).Text));
			НовыйТовар.Категория = Справочники.Категории.НайтиПоКоду(СокрЛП(Лист.Cells(НомерСтроки, 8).Text));
			НовыйТовар.Скидка = Лист.Cells(НомерСтроки, 9).Value;
			НовыйТовар.Описание = СокрЛП(Лист.Cells(НомерСтроки, 10).Text);
			НовыйТовар.Изображение = СокрЛП(Лист.Cells(НомерСтроки, 11).Text);
			
			Попытка
				НовыйТовар.Записать();
				Создано = Создано + 1;
			Исключение
				Сообщить("Не создан товар, строка " + НомерСтроки + ": " + ОписаниеОшибки());
			КонецПопытки;
			
		Иначе
			Сообщить("Товар " + Спр.Наименование + " уже есть");
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Книга.Close();
	Excel.Quit();
	
	Сообщить("Создано элементов: " + Создано);
	
КонецПроцедуры

